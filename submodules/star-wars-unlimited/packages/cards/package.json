{
  "name": "@tcg/star-wars-unlimited-cards",
  "version": "0.0.0",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./pack-simulator": {
      "types": "./src/pack-simulator/index.ts",
      "default": "./src/pack-simulator/index.ts"
    },
    "./data": {
      "types": "./src/data/sets.ts",
      "default": "./src/data/sets.ts"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "main": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./pack-simulator": {
        "types": "./dist/pack-simulator/index.d.mts",
        "default": "./dist/pack-simulator/index.mjs"
      },
      "./data": {
        "types": "./dist/data/sets.d.mts",
        "default": "./dist/data/sets.mjs"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "import:card-data": "node ../../tools/import-card-data/src/import-card-data.mjs",
    "check-types": "tsc -p tsconfig.json --noEmit",
    "test": "vp test run",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "@tcg/shared": "link:../../../agnostic-simulator/packages/shared",
    "@tcg/star-wars-unlimited-types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  }
}
