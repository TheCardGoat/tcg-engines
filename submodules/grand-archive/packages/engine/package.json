{
  "name": "@tcg/grand-archive-engine",
  "version": "0.0.0",
  "private": true,
  "description": "Grand Archive deterministic rules engine and simulator runtime.",
  "type": "module",
  "exports": {
    "./runtime": {
      "types": "./src/runtime-api.ts",
      "default": "./src/runtime-api.ts"
    },
    "./simulator": {
      "types": "./src/simulator-api.ts",
      "default": "./src/simulator-api.ts"
    },
    "./automation": {
      "types": "./src/automation/index.ts",
      "default": "./src/automation/index.ts"
    },
    "./log": {
      "types": "./src/log/index.ts",
      "default": "./src/log/index.ts"
    },
    "./testing": {
      "types": "./src/testing/index.ts",
      "default": "./src/testing/index.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack src/runtime-api.ts src/simulator-api.ts src/automation/index.ts src/log/index.ts src/testing/index.ts --dts",
    "bench": "node --experimental-transform-types --no-warnings scripts/automated-bench.ts",
    "check-types": "tsc -p tsconfig.json --noEmit",
    "test": "vp test run --maxWorkers=2 --testTimeout=15000"
  },
  "dependencies": {
    "@tcg/grand-archive-cards": "workspace:*",
    "@tcg/grand-archive-types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  }
}
