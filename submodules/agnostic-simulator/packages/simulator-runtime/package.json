{
  "name": "@tcg/simulator-runtime",
  "version": "0.1.0",
  "private": true,
  "description": "Shared browser runtime helpers for TCG simulator apps.",
  "files": [
    "src/"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./auth": {
      "types": "./src/auth.tsx",
      "default": "./src/auth.tsx"
    },
    "./chat": {
      "types": "./src/chat.ts",
      "default": "./src/chat.ts"
    },
    "./debug": {
      "types": "./src/debug.ts",
      "default": "./src/debug.ts"
    },
    "./gateway": {
      "types": "./src/gateway.ts",
      "default": "./src/gateway.ts"
    },
    "./replay-playback": {
      "types": "./src/replay-playback.ts",
      "default": "./src/replay-playback.ts"
    },
    "./replay-library": {
      "types": "./src/replay-library.ts",
      "default": "./src/replay-library.ts"
    },
    "./animation": {
      "types": "./src/animation/index.ts",
      "default": "./src/animation/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check-types": "tsc --noEmit",
    "test": "vp test run --configLoader runner",
    "format": "vp fmt ./src",
    "lint": "vp lint ./src"
  },
  "dependencies": {
    "@tcg/game-page-contract": "link:../game-page-contract",
    "@tcg/protocol": "link:../protocol",
    "@tcg/simulator-contract": "link:../simulator-contract",
    "socket.io-client": "catalog:",
    "socket.io-msgpack-parser": "catalog:"
  },
  "devDependencies": {
    "@tcg/typescript-config": "link:../typescript-config",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@typescript/native": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  }
}
