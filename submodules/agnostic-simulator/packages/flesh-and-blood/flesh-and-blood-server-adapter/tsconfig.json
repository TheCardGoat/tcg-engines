{
  "include": ["src/**/*"],
  "exclude": ["node_modules", "**/*.test.ts"],
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@tcg/flesh-and-blood-cards": ["../../../../flesh-and-blood/packages/cards/src/index.ts"],
      "@tcg/flesh-and-blood-cards/catalog": [
        "../../../../flesh-and-blood/packages/cards/src/catalog.ts"
      ],
      "@tcg/flesh-and-blood-cards/runtime-registry": [
        "../../../../flesh-and-blood/packages/cards/src/runtime-registry.ts"
      ],
      "@tcg/flesh-and-blood-types": ["../../../../flesh-and-blood/packages/types/src/index.ts"],
      "@tcg/protocol": ["../../protocol/src/index.ts"],
      "@tcg/shared/*": ["../../shared/src/*"]
    }
  }
}
