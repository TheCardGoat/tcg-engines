{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "$ref": "#/$defs/__schema0"
    },
    {
      "$ref": "#/$defs/__schema3"
    },
    {
      "$ref": "#/$defs/__schema5"
    },
    {
      "$ref": "#/$defs/__schema6"
    },
    {
      "$ref": "#/$defs/__schema7"
    },
    {
      "$ref": "#/$defs/__schema8"
    }
  ],
  "$defs": {
    "__schema0": {
      "type": "object",
      "properties": {
        "v": {
          "$ref": "#/$defs/__schema1"
        },
        "type": {
          "type": "string",
          "const": "hello"
        },
        "credential": {
          "$ref": "#/$defs/__schema2"
        }
      },
      "required": ["v", "type", "credential"],
      "additionalProperties": false
    },
    "__schema1": {
      "type": "number",
      "const": 1
    },
    "__schema2": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "__schema3": {
      "type": "object",
      "properties": {
        "v": {
          "$ref": "#/$defs/__schema1"
        },
        "type": {
          "type": "string",
          "const": "join_game"
        },
        "gameId": {
          "$ref": "#/$defs/__schema2"
        },
        "fixtureIds": {
          "type": "array",
          "prefixItems": [
            {
              "$ref": "#/$defs/__schema2"
            },
            {
              "$ref": "#/$defs/__schema2"
            }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "lastSequence": {
          "$ref": "#/$defs/__schema4"
        }
      },
      "required": ["v", "type"],
      "additionalProperties": false
    },
    "__schema4": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "__schema5": {
      "type": "object",
      "properties": {
        "v": {
          "$ref": "#/$defs/__schema1"
        },
        "type": {
          "type": "string",
          "const": "submit_interaction"
        },
        "gameId": {
          "$ref": "#/$defs/__schema2"
        },
        "correlationId": {
          "$ref": "#/$defs/__schema2"
        },
        "expectedVersion": {
          "$ref": "#/$defs/__schema4"
        },
        "submission": {
          "type": "object",
          "properties": {
            "protocolVersion": {
              "type": "number",
              "const": 2
            },
            "stateVersion": {
              "$ref": "#/$defs/__schema4"
            },
            "requestId": {
              "type": "string",
              "minLength": 1
            },
            "actionId": {
              "type": "string",
              "minLength": 1
            },
            "values": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  }
                ]
              }
            },
            "automation": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "no-valid-action"
                }
              },
              "required": ["kind"],
              "additionalProperties": false
            },
            "correlationId": {
              "$ref": "#/$defs/__schema2"
            }
          },
          "required": [
            "protocolVersion",
            "stateVersion",
            "requestId",
            "actionId",
            "values",
            "correlationId"
          ],
          "additionalProperties": false
        }
      },
      "required": ["v", "type", "gameId", "correlationId", "expectedVersion", "submission"],
      "additionalProperties": false
    },
    "__schema6": {
      "type": "object",
      "properties": {
        "v": {
          "$ref": "#/$defs/__schema1"
        },
        "type": {
          "type": "string",
          "const": "request_game_state_sync"
        },
        "gameId": {
          "$ref": "#/$defs/__schema2"
        }
      },
      "required": ["v", "type", "gameId"],
      "additionalProperties": false
    },
    "__schema7": {
      "type": "object",
      "properties": {
        "v": {
          "$ref": "#/$defs/__schema1"
        },
        "type": {
          "type": "string",
          "const": "ping"
        },
        "nonce": {
          "$ref": "#/$defs/__schema2"
        }
      },
      "required": ["v", "type", "nonce"],
      "additionalProperties": false
    },
    "__schema8": {
      "type": "object",
      "properties": {
        "v": {
          "$ref": "#/$defs/__schema1"
        },
        "type": {
          "type": "string",
          "const": "pong"
        },
        "nonce": {
          "$ref": "#/$defs/__schema2"
        }
      },
      "required": ["v", "type", "nonce"],
      "additionalProperties": false
    }
  }
}
