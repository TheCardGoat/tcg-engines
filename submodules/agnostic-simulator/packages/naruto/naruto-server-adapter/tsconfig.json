{
  "include": ["src/**/*"],
  "exclude": ["node_modules", "**/*.test.ts"],
  "compilerOptions": {
    "types": ["node", "@types/bun"],
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@tcg-engines/naruto-cards": ["../../../../naruto/packages/cards/src/index.ts"],
      "@tcg-engines/naruto-engine": ["../../../../naruto/packages/engine/src/index.ts"]
    }
  }
}
