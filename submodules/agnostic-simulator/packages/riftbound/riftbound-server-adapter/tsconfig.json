{
  "include": ["src/**/*"],
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@tcg/card-model": ["../../card-model/src/index.ts"],
      "@tcg/riftbound-cards": ["../../../../riftbound/packages/cards/src/index.ts"],
      "@tcg/riftbound-decks": ["../../../../riftbound/packages/decks/src/index.ts"],
      "@tcg/riftbound-types": ["../../../../riftbound/packages/types/src/index.ts"],
      "@tcg/shared/*": ["../../shared/src/*"]
    }
  }
}
