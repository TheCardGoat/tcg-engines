{
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "lib": ["ES2024", "DOM"],
    "types": ["vite-plus/client", "vitest/globals"],
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react",

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting. Unused-symbol and erasable-syntax style flags stay with the
       per-workspace oxlint/oxfmt gates: this program transitively compiles
       imported engine sources from other workspaces whose own green gates
       do not enforce them, so keeping them here is permanently red noise.
       Type-correctness checking stays on. */
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@tcg/simulator-ui": ["../../packages/simulator-ui/src/index.ts"],
      "@cyberpunk-engine/*": ["../../../cyberpunk/packages/engine/src/*"],
      "@cyberpunk-simulator/*": ["./src/games/cyberpunk/*"],
      "@cyberpunk/*": ["./src/games/cyberpunk/*"],
      "@e2e/*": ["./e2e/*"],
      "@gundam-simulator/*": ["./src/games/gundam/*"],
      "@tcg/op-engine": ["../../../one-piece/packages/engine/src/index.ts"],
      "@tcg/op-engine/practice-st01": ["../../../one-piece/packages/engine/src/practice-st01.ts"],
      "@tcg/op-cards": ["../../../one-piece/packages/cards/src/index.ts"],
      "@tcg/simulator-testing": ["../../packages/simulator-testing/src/index.ts"],
      "@tcg/simulator-testing/testing-library": [
        "../../packages/simulator-testing/src/testing-library.ts"
      ]
    }
  },
  "include": [
    "src",
    "server",
    "card-tests",
    "../../../cyberpunk/packages/engine/src/testing/matchers.d.ts"
  ]
}
