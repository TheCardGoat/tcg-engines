{
  "name": "@tcg/riftbound-parser",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "check-types": "tsc -p tsconfig.json --noEmit",
    "test": "vp test run",
    "generate": "node --experimental-transform-types src/cli.ts generate",
    "verify:catalog": "node --experimental-transform-types src/cli.ts verify"
  },
  "dependencies": {
    "@tcg/riftbound-types": "workspace:*",
    "sanitize-html": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/sanitize-html": "catalog:",
    "@typescript/native": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  }
}
