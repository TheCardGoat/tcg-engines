{
  "name": "@tcg/flesh-and-blood-catalog",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "check-types": "tsc -p tsconfig.json --noEmit",
    "generate": "node --experimental-transform-types src/cli.ts generate",
    "refresh": "node --experimental-transform-types src/refresh.ts",
    "audit:catalog": "node --experimental-transform-types src/cli.ts audit",
    "test": "vp test run",
    "verify:catalog": "node --experimental-transform-types src/cli.ts verify",
    "generate:localized": "node --experimental-transform-types src/localized-cli.ts"
  },
  "dependencies": {
    "@tcg/card-model": "link:../../../agnostic-simulator/packages/card-model",
    "@tcg/flesh-and-blood-types": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "oxfmt": "0.57.0",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  }
}
