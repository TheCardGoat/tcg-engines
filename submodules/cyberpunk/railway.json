{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "dockerfile",
    "dockerfilePath": "submodules/cyberpunk/Dockerfile",
    "watchPatterns": [
      "railway-deploy-trigger.txt",
      "submodules/cyberpunk/**"
    ]
  },
  "deploy": {
    "startCommand": "node server.js",
    "restartPolicyMaxRetries": 3,
    "restartPolicyWindowSeconds": 60
  }
}
