{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "dockerfile",
    "dockerfile": "submodules/gundam/Dockerfile",
    "watchPatterns": [
      "railway-deploy-trigger.txt",
      "submodules/gundam/**"
    ]
  },
  "deploy": {
    "startCommand": "node server.js",
    "restartPolicyMaxRetries": 3,
    "restartPolicyWindowSeconds": 60,
    "sleepApplication": false
  },
  "environments": {
    "production": {
      "deploy": {
        "sleepApplication": false,
        "limitOverride": {
          "containers": {
            "cpu": 8,
            "memoryBytes": 8000000000
          }
        }
      }
    },
    "staging": {
      "deploy": {
        "sleepApplication": true,
        "limitOverride": {
          "containers": {
            "cpu": 2,
            "memoryBytes": 2000000000
          }
        }
      }
    }
  }
}
