{
  "name": "@tcg/op-engine",
  "version": "0.0.0",
  "description": "A starter for creating a TypeScript package.",
  "homepage": "https://github.com/author/library#readme",
  "bugs": {
    "url": "https://github.com/author/library/issues"
  },
  "license": "MIT",
  "author": "Author Name <author.name@mail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/author/library.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./practice-st01": {
      "types": "./src/practice-st01.ts",
      "default": "./src/practice-st01.ts"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "main": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./practice-st01": {
        "types": "./dist/practice-st01.d.mts",
        "default": "./dist/practice-st01.mjs"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test run",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "@tcg/bot-core": "link:../../../agnostic-simulator/packages/bot-core",
    "@tcg/engine-core": "link:../../../agnostic-simulator/packages/engine-core",
    "@tcg/op-cards": "workspace:*",
    "@tcg/op-types": "workspace:*",
    "immer": "catalog:"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@typescript/native-preview": "7.0.0-dev.20260316.1",
    "bumpp": "^11.0.1",
    "typescript": "^5.9.3",
    "vite-plus": "^0.1.11"
  }
}
